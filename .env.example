# Puerto interno del servicio (nginx hace de reverse proxy delante)
PORT=3200
HOST=127.0.0.1

# Base de datos MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dolarprice
DB_USER=dolarprice
DB_PASS=cambiar_esto

# Ajustes de captura
# Cantidad de anuncios P2P a promediar
BINANCE_ROWS=20
# Porcentaje recortado en cada extremo antes de promediar (10 = descarta 10% arriba y 10% abajo)
BINANCE_TRIM_PCT=10
# Segundos que la API considera fresco un dato antes de marcarlo como desactualizado
STALE_AFTER_SECONDS=2700

# Lectura de noticias desde verificavenezuela.org (mismo servidor, PostgreSQL).
# El usuario solo tiene SELECT sobre news, media y categories.
VV_DB_HOST=127.0.0.1
VV_DB_PORT=5432
VV_DB_NAME=verifica_venezuela
VV_DB_USER=dolarprice_ro
VV_DB_PASS=cambiar_esto

# ─── Panel de estadisticas (/admin) ───────────────────────────────────────
# Sin ADMIN_PASS_HASH el panel no deja entrar a nadie. Las dos lineas se
# generan de una vez con:  npm run admin:pass
# La contrasena en claro no se guarda en ningun sitio, solo su hash scrypt.
ADMIN_PASS_HASH=
# Clave con la que se firma la cookie de sesion. Si se cambia, se cierran
# todas las sesiones abiertas. Si se deja vacia se genera una al arrancar,
# y entonces cada reinicio del servicio obliga a entrar de nuevo.
ADMIN_SESSION_SECRET=
# Solo para desarrollo en local, donde se entra por http://127.0.0.1 y el
# navegador tiraria una cookie marcada Secure. En produccion NO poner esto.
# ADMIN_COOKIE_INSEGURA=1

# Desfase horario para agrupar por dia y por hora en el panel. Venezuela es
# UTC-4 todo el ano. En la base se sigue guardando todo en UTC.
TZ_OFFSET_HORAS=-4
# Dias que se conservan las visitas en detalle. El resumen por visitante
# (tabla visitors) no se borra nunca.
ANALYTICS_RETENCION_DIAS=180
# Ruta de la base de geolocalizacion. Por defecto data/dbip-city-lite.mmdb,
# que se descarga con:  npm run geoip
# GEOIP_MMDB=
