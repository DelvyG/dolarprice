[Unit]
Description=DolarPrice - captura de tasas BCV y Binance
After=network-online.target mariadb.service

[Service]
Type=oneshot
User=dolarprice
Group=dolarprice
WorkingDirectory=/var/www/dolarprice
ExecStart=/usr/bin/node src/ingest.js
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/dolarprice
