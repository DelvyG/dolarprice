#!/usr/bin/env bash
# Despliegue de DolarPrice. Vive en /usr/local/bin/dolarprice-deploy y lo invoca
# GitHub Actions por SSH con una llave restringida a este unico comando.
set -euo pipefail

RUTA=/var/www/dolarprice
RAMA=main

echo "==> Desplegando DolarPrice"
cd "$RUTA"

# .env nunca esta en el repo: se conserva el del servidor.
sudo -u dolarprice git fetch --prune origin "$RAMA"
sudo -u dolarprice git reset --hard "origin/$RAMA"

# ── Dependencias ─────────────────────────────────────────────────────────────
# `npm ci` BORRA node_modules antes de reinstalar. Si falla a medias, el
# directorio queda vacio y el servicio sigue vivo unicamente porque Node ya
# tiene los modulos cargados en memoria: el sitio se cae en el siguiente
# reinicio, que puede ser horas despues y sin relacion aparente con esto.
# Paso de verdad el 26/08/2026 -- npm ci revento con un ENOENT y dejo
# node_modules en cero; a la segunda corrida entro sin tocar nada.
#
# Contabo es una maquina compartida con otros proyectos corriendo npm a la vez,
# asi que un tropiezo puntual es esperable. De ahi los reintentos y, sobre todo,
# la comprobacion de que los modulos CARGAN antes de reiniciar nada.
echo "==> Dependencias"
instalado=0
for intento in 1 2 3; do
  if sudo -u dolarprice npm ci --omit=dev; then instalado=1; break; fi
  echo "    npm ci fallo (intento $intento de 3), reintentando..." >&2
  sleep 3
done

if [ "$instalado" != "1" ]; then
  echo "    ultimo recurso: npm install --omit=dev" >&2
  sudo -u dolarprice npm install --omit=dev --no-audit --no-fund || true
fi

# Que los ficheros existan no basta: tienen que poder cargarse. Esta es la
# comprobacion que de verdad impide reiniciar sobre un node_modules roto.
echo "==> Comprobando que las dependencias cargan"
if ! sudo -u dolarprice node -e "
  Promise.all(['fastify','@fastify/static','mysql2/promise','pg','maxmind'].map((m) => import(m)))
    .then(() => console.log('    ok, los modulos cargan'))
    .catch((e) => { console.error('    NO CARGAN: ' + e.message); process.exit(1) })
"; then
  echo "FALLO: node_modules quedo inservible. NO se reinicia el servicio." >&2
  echo "       El sitio sigue corriendo con lo que Node tiene en memoria, pero" >&2
  echo "       esta a un reinicio de caerse. Arreglar cuanto antes:" >&2
  echo "         cd $RUTA && sudo -u dolarprice npm ci --omit=dev" >&2
  exit 1
fi

echo "==> Esquema de base de datos"
sudo -u dolarprice node scripts/migrate.js

echo "==> Reiniciando servicio"
systemctl restart dolarprice
sleep 2

echo "==> Comprobacion"
CODIGO=$(curl -s -o /dev/null -w "%{http_code}" --max-time 10 http://127.0.0.1:3200/api/v1/health)
if [ "$CODIGO" != "200" ]; then
  echo "FALLO: la API responde $CODIGO" >&2
  systemctl status dolarprice --no-pager | tail -20
  exit 1
fi

echo "==> Listo. API 200."
